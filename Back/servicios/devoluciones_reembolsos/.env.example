PORT=4008
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@xxxxx.pooler.supabase.com:6543/postgres
# TDSI-68: el comprobante de venta (factura con sus items y metodos de pago) se consulta a facturacion
FACTURACION_URL=http://localhost:4002

# TDSI-77: aviso a Inventario (Modulo de Gestion de Inventarios y Almacen) por Google Pub/Sub.
# Topico de Inventario (vacio = el aviso queda Pendiente y no se publica). Confirmar con ese grupo
# el nombre de su topico; el patron del curso es projects/project-a96e5fe1-5ba6-4698-a85/topics/ucb-sis323-sub-<grupo>.
INVENTARIO_PUBSUB_TOPIC=
# Credencial (una de las dos; el .env nunca se sube): la misma cuenta de servicio que ya usan
# facturacion, gestion_pagos, gestion_caja y pagos_proveedores.
#  a) la llave pegada aqui en UNA sola linea y entre comillas simples (o en base64)
GOOGLE_CREDENTIALS_JSON=
#  b) ruta ABSOLUTA al JSON de la llave, guardado FUERA del repositorio
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_TIMEOUT_MS=10000
