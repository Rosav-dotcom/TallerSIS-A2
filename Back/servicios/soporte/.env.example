PORT=4007
# Misma base de datos de Supabase que los otros microservicios (esquema "soporte").
# Usar el Transaction pooler (puerto 6543).
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@xxxxx.pooler.supabase.com:6543/postgres

# Soporte solo LEE facturas y pagos por las APIs de sus dueños; nunca los modifica.
FACTURACION_URL=http://localhost:4002
GESTION_PAGOS_URL=http://localhost:4005
